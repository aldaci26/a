{
  "appId": "com.kitaplik.app",
  "productName": "Kitaplığım",
  "copyright": "Copyright © 2026",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/icon.ico",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Kitaplığım",
    "installerIcon": "public/icon.ico",
    "uninstallerIcon": "public/icon.ico",
    "uninstallDisplayName": "Kitaplığım Kaldır"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}"
  }
}
